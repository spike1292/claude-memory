node_modules/

# Eval case sets are generated from a real vault and contain its content.
# They stay machine-local under $CLAUDE_MEMORY_HOME/eval/ and are never committed.
eval-cases-*.jsonl

# Personal Claude Code permission grants. settings.json IS tracked — it is project policy — but
# settings.local.json is per-machine and holds whatever tooling that developer happens to use.
# Ignored rather than merely untracked because a stray `git add -A` is exactly how the tracked
# file collected one-off entries in the first place (see the commit that curated it).
.claude/settings.local.json

# State, indexes, logs — all of it belongs in $CLAUDE_MEMORY_HOME, never in the repo.
*.db
*.db-shm
*.db-wal
*.log
*.sock

__pycache__/
*.pyc

.DS_Store
